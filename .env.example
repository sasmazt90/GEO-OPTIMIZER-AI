# Models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: pin the model used for a tracked surface (PROBE_MODEL_CHATGPT, _CLAUDE, _GEMINI, _PERPLEXITY)

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
REQUIRE_SUPABASE=true

# Stripe billing (leave empty to run without online checkout)
# Use a restricted key (rk_...): Customers write, Checkout Sessions write,
# Customer portal write, Subscriptions read, Prices read, Charges read.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Comma-separated emails that always get the Agency plan (owner accounts)
ADMIN_EMAILS=

PORT=8787
APP_URL=https://geo-optimizer-ai.sasmaz.digital
