# Models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: pin the model used for a tracked surface (PROBE_MODEL_CHATGPT, _CLAUDE, _GEMINI, _PERPLEXITY)

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
REQUIRE_SUPABASE=true

# Stripe billing (leave empty to run without online checkout)
# Use a restricted key (rk_...): Customers write, Checkout Sessions write,
# Customer portal write, Subscriptions read, Prices read, Charges read.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Comma-separated emails that always get the Agency plan (owner accounts)
ADMIN_EMAILS=

# Google Search Console (optional). OAuth web client with the redirect URI
# APP_URL + /api/gsc/callback and the Search Console API enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Secret used to encrypt stored Google tokens. Falls back to JWT_SECRET, then SUPABASE_SECRET_KEY.
TOKEN_ENCRYPTION_KEY=

# PageSpeed Insights API key (optional; without it Google applies a low shared quota)
PAGESPEED_API_KEY=

# Set to true to switch off JavaScript rendering in the site audit
RENDER_DISABLED=

PORT=8787
APP_URL=https://geo-optimizer-ai.sasmaz.digital
