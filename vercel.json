{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!og\\.png|robots\\.txt|sitemap\\.xml|llms\\.txt|favicon\\.svg|icons\\.svg|assets/).*)", "destination": "/index.html" }
  ]
}
